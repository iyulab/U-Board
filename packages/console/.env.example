# Origin the embed viewer (`packages/share`) is served from — the console builds shareable board
# links against it. Falls back to the console's own origin when unset, which only works if the two
# apps are deployed on the same origin. Value below matches the local dev setup.
VITE_SHARE_BASE_URL=http://localhost:5176

# Server API origin. Unset in local dev (falls back to '', relying on the vite proxy in
# vite.config.ts). Set to https://api.board.u-platform.kr in production.
VITE_API_BASE_URL=
