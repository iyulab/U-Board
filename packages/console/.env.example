# Where the embed viewer (`packages/share`) is served — the console builds shareable board links
# against it. Unset: `/share` on the console's own origin, which is where the server serves it.
# Value below matches the local dev setup (the viewer's own dev server).
VITE_SHARE_BASE_URL=http://localhost:5176

# Origin of the server whose API (`/api`) the console calls. Unset when the server serves the console
# itself, and in local dev (the vite proxy in vite.config.ts forwards /api). Set it only when the
# console is hosted apart from the server.
VITE_API_BASE_URL=
