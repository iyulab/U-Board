{
  "name": "@iyulab/u-board-console",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace/member management console for U-Board",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/bootstrap.spec.ts && playwright test e2e/invite-accept.spec.ts"
  },
  "repository": { "type": "git", "url": "https://github.com/iyulab/U-Board", "directory": "packages/console" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@iyulab/u-board": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.6"
  }
}
