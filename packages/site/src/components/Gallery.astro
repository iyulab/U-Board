---
// Sample boards, one card each: what field and what kind of background, the board itself (drawn by the
// library viewer from recorded answers once the page runs script), and when the answers were recorded — or,
// for a board on example data, that they are an example.
import Page from './Page.astro';
import { COPY, type Locale } from '../copy';
import { SAMPLE_PACKS, isInstallable, ownKeyConnectors } from '@iyulab/u-board-samples';
import { expandComponents, sizedNodes, type CanvasView } from '@iyulab/u-board/domain';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = COPY[locale];
const g = c.gallery;
const time = (iso: string) =>
  new Intl.DateTimeFormat(locale === 'ko' ? 'ko-KR' : 'en-GB', {
    year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'Asia/Seoul', timeZoneName: 'short',
  }).format(new Date(iso));
// A board drawn over a background keeps its drawing's proportions; one with no drawing, those of its parts (with the
// viewer's margin around them); a grid has none, and is as tall as its items.
const partsExtent = (document: CanvasView) => {
  const nodes = sizedNodes(expandComponents(document));
  const width = Math.max(...nodes.map(n => n.x + n.width)) - Math.min(...nodes.map(n => n.x));
  const height = Math.max(...nodes.map(n => n.y + n.height)) - Math.min(...nodes.map(n => n.y));
  return { width: width + 32, height: height + 32 };
};
const cards = SAMPLE_PACKS.map(pack => {
  const image = pack.document.kind === 'canvas' ? (pack.document.background.image ?? partsExtent(pack.document)) : undefined;
  const ownKeys = ownKeyConnectors(pack).map(c => g.ownKey.replace('{host}', new URL(c.ownKey!.signUpUrl).host));
  const recorded = isInstallable(pack) ? [g.recorded.replace('{time}', time(pack.snapshot.capturedAt)), ...ownKeys].join(' ') : g.example;
  return { pack, aspect: image ? `aspect-ratio: ${image.width} / ${image.height}; --ratio: ${(image.width / image.height).toFixed(3)}` : undefined, portrait: !!image && image.height > image.width, recorded };
});
---

<Page locale={locale} page="gallery" title={g.title} description={g.description}>
  <section class="gallery" data-claim="gallery">
    <div class="gallery-head">
      <h1>{g.heading}</h1>
      <p>{g.intro}</p>
    </div>
    <nav class="gallery-index" aria-label={g.index}>
      <ol>
        {
          cards.map(({ pack }) => (
            <li>
              <a href={`#${pack.id}`}>{pack.title[locale]}</a>
              <span>{pack.field[locale]} · {pack.kind[locale]}</span>
            </li>
          ))
        }
      </ol>
    </nav>
    {
      cards.map(({ pack, aspect, portrait, recorded }) => (
        <article class="sample" id={pack.id}>
          <header class="sample-head">
            <h2>{pack.title[locale]}</h2>
            <dl class="sample-tags">
              <div>
                <dt>{g.field}</dt>
                <dd>{pack.field[locale]}</dd>
              </div>
              <div>
                <dt>{g.kind}</dt>
                <dd>{pack.kind[locale]}</dd>
              </div>
            </dl>
            <p class="sample-summary">{pack.summary[locale]}</p>
          </header>
          <div class:list={['sample-board', { 'sample-board--grid': !aspect, 'sample-board--portrait': portrait }]} style={aspect} data-sample-board={pack.id} data-label={pack.title[locale]}>
            <noscript>{pack.summary[locale]}</noscript>
          </div>
          <p class="sample-recorded">{recorded}</p>
        </article>
      ))
    }
  </section>
</Page>

<script>
  import '../live/gallery';
</script>

<style>
  .gallery {
    padding-block: 2.5rem 3rem;
  }
  .gallery-head {
    max-width: 46rem;
    margin-bottom: 2rem;
  }
  .gallery-head h1 {
    margin: 0 0 0.75rem;
  }
  .gallery-head p,
  .sample-summary {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
    word-break: keep-all;
  }
  .gallery-index {
    margin: 0 0 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line, #d6dedb);
    border-radius: 8px;
  }
  .gallery-index ol {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.6rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery-index li {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .gallery-index a {
    font-weight: 600;
    word-break: keep-all;
  }
  .gallery-index span {
    font-size: 0.8125rem;
    color: var(--muted);
    word-break: keep-all;
  }
  .sample {
    margin-block: 0 3rem;
    /* A jump from the index lands the board's heading under the page's top edge, not behind it. */
    scroll-margin-top: 1.5rem;
    /* The board's box takes its height from the card's width (cqi). */
    container-type: inline-size;
  }
  .sample-head h2 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }
  .sample-tags {
    display: flex;
    gap: 1.25rem;
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }
  .sample-tags div {
    display: flex;
    gap: 0.4rem;
  }
  .sample-tags dt {
    color: var(--muted);
  }
  .sample-tags dd {
    margin: 0;
    font-weight: 600;
  }
  .sample-board {
    width: 100%;
    margin-top: 1rem;
    border: 1px solid var(--line, #d6dedb);
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
  }
  /* The viewer's toolbar and its credit line sit inside the box with the board, so give them room: as tall as the
     board is at the card's width (its drawing's proportions, or its parts'), plus those two, and never past the screen. */
  .sample-board.live {
    aspect-ratio: auto !important;
    height: min(80vh, 760px, calc(100cqi / var(--ratio, 1.6) + 76px));
  }
  /* A portrait board (a kiosk, a printed page) is as wide as the height it gets allows — not the card's whole width
     with the board a strip in the middle of it. */
  .sample-board--portrait {
    max-width: calc((min(80vh, 760px) - 76px) * var(--ratio) + 2px);
    margin-inline: auto;
  }
  /* A grid not drawn yet holds room for itself, so the page does not jump as the boards above it are drawn. */
  .sample-board--grid:not(.live) {
    min-height: 32rem;
  }
  /* A grid has no drawing to fit: it is as tall as its items, at the width it is given. */
  .sample-board--grid.live {
    height: auto;
  }
  .sample-recorded {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
