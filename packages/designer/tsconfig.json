{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      // The language and the renderer are read from their sources, so a change there is seen here without a build.
      "@iyulab/u-board": ["../core/src/index.ts"],
      "@iyulab/u-board/domain": ["../core/src/domain-entry.ts"],
      "@iyulab/u-board/picture": ["../core/src/picture-entry.ts"],
      "@iyulab/u-board/toolkit": ["../core/src/toolkit-entry.ts"],
      "@iyulab/u-board/viewer": ["../core/src/viewer-entry.ts"],
      "@iyulab/u-board/examples": ["../core/src/examples-entry.ts"]
    }
  },
  "include": ["src"]
}
