# UBOARD_DATABASE_URL: ":memory:" (tests only) | a local path (PGlite persisted to disk — the
# zero-setup local-dev default) | a "postgres://..." URL (production, real Postgres via pg.Pool).
UBOARD_DATABASE_URL=./u-board-data
UBOARD_SESSION_SECRET=change-me-to-a-random-32-char-string
# Comma-separated allowlist for CORS (production only — unset in dev, the same-origin proxy
# makes CORS a no-op there). Example: https://board.u-platform.kr,https://share.board.u-platform.kr
UBOARD_CORS_ORIGINS=
PORT=4000
