# UBOARD_DATABASE_URL: ":memory:" (tests only) | a local path (PGlite persisted to disk — the
# zero-setup local-dev default) | a "postgres://..." URL (production, real Postgres via pg.Pool).
UBOARD_DATABASE_URL=./u-board-data
UBOARD_SESSION_SECRET=change-me-to-a-random-32-char-string
# Comma-separated allowlist for CORS (production only — unset in dev, the same-origin proxy
# makes CORS a no-op there). Example: https://board.u-platform.kr,https://share.board.u-platform.kr
UBOARD_CORS_ORIGINS=
# "true" to key the /auth/login and /auth/signup rate limiter off the CF-Connecting-IP header
# instead of req.ip. Enable ONLY once Container App ingress is locked to Cloudflare-only traffic
# (deployment routing plan's infra checklist) — otherwise the header is client-spoofable.
UBOARD_TRUST_CF_PROXY=
PORT=4000
# Sendway (iyulab's shared email/SMS/push service, org/dev-docs/sendway.md) tenant key for
# password-reset emails. Unset in dev/test — falls back to a log-the-token default that keeps the
# reset flow fully usable without a real provider. SENDWAY_BASE_URL overrides the default
# deployment URL (https://sendway.u-platform.kr), for a non-default/staging Sendway instance only.
SENDWAY_API_KEY=
SENDWAY_BASE_URL=
