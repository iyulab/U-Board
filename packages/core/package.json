{
  "name": "@iyulab/u-board",
  "version": "0.7.0",
  "description": "Spatial dashboard authoring middleware",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/U-Board.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/iyulab/U-Board/issues"
  },
  "homepage": "https://github.com/iyulab/U-Board#readme",
  "keywords": [
    "dashboard",
    "canvas",
    "spatial",
    "hmi",
    "data-binding",
    "react"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist/lib",
    "styles.css",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./viewer": {
      "types": "./dist/lib/viewer-entry.d.ts",
      "import": "./dist/lib/viewer-entry.js"
    },
    "./domain": {
      "types": "./dist/lib/domain-entry.d.ts",
      "import": "./dist/lib/domain-entry.js"
    },
    "./demo": {
      "types": "./dist/lib/demo-entry.d.ts",
      "import": "./dist/lib/demo-entry.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual:update": "bash ../../scripts/update-visual-baselines.sh",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@canvas-kit/core": "^0.5.0",
    "@canvas-kit/designer": "^0.7.0",
    "@canvas-kit/viewer": "^0.5.1",
    "@iyulab/u-widgets": "^0.30.0",
    "@lit/react": "^1.0.8",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
