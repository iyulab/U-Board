{
  "name": "@iyulab/u-board",
  "version": "0.2.0",
  "private": true,
  "description": "Spatial dashboard authoring middleware",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./viewer": {
      "types": "./dist/lib/viewer-entry.d.ts",
      "import": "./dist/lib/viewer-entry.js"
    },
    "./domain": {
      "types": "./dist/lib/domain-entry.d.ts",
      "import": "./dist/lib/domain-entry.js"
    },
    "./demo": {
      "types": "./dist/lib/demo-entry.d.ts",
      "import": "./dist/lib/demo-entry.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/U-Board",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@canvas-kit/core": "^0.2.0",
    "@canvas-kit/designer": "^0.3.0",
    "@canvas-kit/viewer": "^0.2.0",
    "@iyulab/u-widgets": "^0.16.1",
    "@lit/react": "^1.0.8",
    "echarts": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.6"
  }
}
