{
  "name": "@iyulab/u-board",
  "version": "0.1.0",
  "private": true,
  "description": "Spatial dashboard authoring middleware",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": ["dist/lib"],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/U-Board"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@canvas-kit/core": "^0.2.0",
    "@canvas-kit/designer": "^0.2.0",
    "@canvas-kit/viewer": "^0.2.0",
    "@iyulab/u-widgets": "^0.16.1",
    "@lit/react": "^1.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.6"
  }
}
